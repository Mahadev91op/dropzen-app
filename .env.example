# ==============================================================================
# CardVault Production Environment Variables Template
# Copy this file to .env.local for local development or add to your hosting provider
# (Vercel, Railway, Render, VPS) under Project Settings > Environment Variables.
# ==============================================================================

# 1. MongoDB Database Connection String
# Ensure your MongoDB Atlas cluster allows Network Access from everywhere (0.0.0.0/0)
# for serverless cloud deployments like Vercel.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.arcmqtz.mongodb.net/dropzen?retryWrites=true&w=majority

# 2. Authentication Secret (Random secure 32+ character string)
JWT_SECRET=your_super_secret_jwt_random_key_change_in_production_2026

# 3. Production Website Domain (Used for email notification links)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# 4. Administrator Access Configuration
ADMIN_EMAILS=admin@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# 5. Gmail / SMTP Email Notifications Service
# To send automated receipt and approval emails, generate an App Password from Google Account:
# Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_app_password
