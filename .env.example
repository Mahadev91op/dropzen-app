# ==============================================================================
# Dropzen Production Environment Variables Template
# Copy this file to .env.local for local development or configure in your cloud host
# (Vercel, Render, Railway, VPS) under Project Settings > Environment Variables.
# ==============================================================================

# 1. MongoDB Database Connection String
# IMPORTANT: For Vercel or serverless deployments, ensure MongoDB Atlas -> Network Access
# has 0.0.0.0/0 (Allow access from anywhere) enabled.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yourcluster.mongodb.net/dropzen?retryWrites=true&w=majority

# 2. Authentication Secret (Random secure 32+ character string)
JWT_SECRET=your_super_secret_jwt_random_key_change_in_production_2026

# 3. Production Website Domain (Used for SEO, OpenGraph, and Manifest)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# 4. Administrator Access Configuration (Comma-separated admin emails)
ADMIN_EMAILS=admin@yourdomain.com
